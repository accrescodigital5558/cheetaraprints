# Placeholder values such as 123 / 2334 are not shown on the site.
NEXT_PUBLIC_SITE_URL=https://cheetaraprints.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
